---
const links = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#resume', label: 'Résumé' },
  { href: '#portfolio', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  id="nav"
  class="fixed top-0 inset-x-0 z-40 flex items-center justify-between px-6 md:px-10 py-4 transition-all duration-300 [&.scrolled]:bg-bg/80 [&.scrolled]:backdrop-blur-md [&.scrolled]:border-b [&.scrolled]:border-line"
>
  <a href="#home" data-scroll class="font-display text-xl font-bold text-ink tracking-wide">
    RB<span class="text-accent2">.</span>
  </a>

  <nav id="navLinks" class="nav-links hidden md:flex items-center gap-8">
    {links.map((link) => (
      <a
        href={link.href}
        data-scroll
        class="relative text-sm font-medium text-muted hover:text-ink transition-colors [&.active]:text-ink after:absolute after:left-0 after:-bottom-1 after:h-[2px] after:w-0 after:bg-gradient-to-r after:from-accent after:to-accent2 after:transition-all [&.active]:after:w-full"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <button
    id="navToggle"
    aria-label="Toggle menu"
    class="nav-toggle relative z-50 flex md:hidden flex-col justify-center items-center gap-[5px] w-9 h-9"
  >
    <span class="block h-[2px] w-6 bg-ink transition-transform"></span>
    <span class="block h-[2px] w-6 bg-ink transition-opacity"></span>
    <span class="block h-[2px] w-6 bg-ink transition-transform"></span>
  </button>
</header>

<div
  id="navLinksMobile"
  class="fixed inset-0 z-30 flex md:hidden flex-col items-center justify-center gap-8 bg-bg2/98 backdrop-blur-lg translate-x-full transition-transform duration-300"
>
  {links.map((link) => (
    <a
      href={link.href}
      data-scroll
      class="mobile-nav-link text-2xl font-display font-semibold text-ink hover:text-accent2 transition-colors"
    >
      {link.label}
    </a>
  ))}
</div>

<style>
  #navLinksMobile.open {
    transform: translateX(0);
  }
  #navToggle.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #navToggle.open span:nth-child(2) {
    opacity: 0;
  }
  #navToggle.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
