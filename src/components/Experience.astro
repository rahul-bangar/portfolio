---
const items = [
  {
    period: 'Feb 2025 — Present',
    company: 'Amazon',
    role: 'Software Development Engineer',
    meta: 'Full Time',
    location: 'Bengaluru, Karnataka, India — Onsite',
  },
  {
    period: 'Sep 2024 — Jan 2025',
    company: 'Accenture',
    role: 'Advanced App Engineering Analyst',
    meta: 'Full Time',
    location: 'Hyderabad, Telangana, India — Onsite',
  },
  {
    period: 'Jun 2023 — Jul 2023',
    company: 'Accenture',
    role: 'Advanced App Engineering Analyst',
    meta: 'Intern',
    location: 'India — Remote',
  },
];
---

<section id="experience" class="py-24 px-6 md:px-10">
  <div class="mx-auto max-w-content">
    <div class="reveal mb-14">
      <span class="text-accent2 font-semibold tracking-widest uppercase text-sm">02 — Experience</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mt-2">Where I've Worked</h2>
    </div>

    <div class="relative pl-8 md:pl-10">
      <div class="absolute left-[7px] md:left-[9px] top-2 bottom-2 w-[2px] bg-gradient-to-b from-accent via-accent2 to-transparent"></div>
      <div class="stagger flex flex-col gap-10">
        {items.map((item) => (
          <div class="relative">
            <span class="absolute -left-8 md:-left-10 top-1.5 w-4 h-4 rounded-full grad shadow-[0_0_0_4px_rgba(124,92,255,0.15)]"></span>
            <p class="text-accent2 text-sm font-semibold mb-1">{item.period}</p>
            <h3 class="font-display text-xl font-semibold text-ink">
              {item.role} · <span class="text-ink/90">{item.company}</span>
            </h3>
            <p class="text-muted text-sm mt-1">{item.meta} · {item.location}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
