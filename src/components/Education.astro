---
const items = [
  {
    period: 'Dec 2020 — Aug 2024',
    title: 'B.Tech, Computer Science & Engineering',
    place: 'National Institute of Technology, Tiruchirappalli',
  },
  {
    period: 'Jul 2018 — Mar 2020',
    title: 'Class XI & XII',
    place: 'Saraswati Public School',
  },
  {
    period: 'Apr 2004 — Mar 2018',
    title: 'High School',
    place: 'Jawahar Lal Nehru High School',
  },
];
---

<section id="education" class="py-24 px-6 md:px-10">
  <div class="mx-auto max-w-content">
    <div class="reveal mb-14">
      <span class="text-accent2 font-semibold tracking-widest uppercase text-sm">03 — Education</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mt-2">Education</h2>
    </div>

    <div class="relative pl-8 md:pl-10">
      <div class="absolute left-[7px] md:left-[9px] top-2 bottom-2 w-[2px] bg-gradient-to-b from-accent via-accent2 to-transparent"></div>
      <div class="stagger flex flex-col gap-10">
        {items.map((item) => (
          <div class="relative">
            <span class="absolute -left-8 md:-left-10 top-1.5 w-4 h-4 rounded-full grad shadow-[0_0_0_4px_rgba(124,92,255,0.15)]"></span>
            <p class="text-accent2 text-sm font-semibold mb-1">{item.period}</p>
            <h3 class="font-display text-xl font-semibold text-ink">{item.title}</h3>
            <p class="text-muted text-sm mt-1">{item.place}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
