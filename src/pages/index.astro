---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Resume from '../components/Resume.astro';
import Work from '../components/Work.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <!-- Static aurora background: painted once, zero per-frame cost. -->
  <div
    class="fixed inset-0 -z-10"
    aria-hidden="true"
    style="background:
      radial-gradient(42% 38% at 10% 6%, rgba(124,92,255,0.26), transparent 72%),
      radial-gradient(40% 40% at 90% 32%, rgba(34,211,238,0.18), transparent 72%),
      radial-gradient(46% 44% at 85% 96%, rgba(255,111,145,0.12), transparent 72%);"
  >
  </div>

  <!-- Scroll progress bar -->
  <div
    id="scrollProgress"
    class="fixed top-0 left-0 right-0 h-[3px] origin-left scale-x-0 grad z-50"
  >
  </div>

  <Nav />

  <main>
    <Hero />
    <About />
    <Resume />
    <Work />
    <Contact />
  </main>

  <Footer />

  <a
    id="backToTop"
    href="#home"
    data-scroll
    aria-label="Back to top"
    class="show:opacity-100 fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full grad flex items-center justify-center text-bg shadow-lg opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
  >
    <Icon name="arrow-up" class="w-4 h-4" />
  </a>

  <script>
    (function () {
      'use strict';

      document.addEventListener('DOMContentLoaded', function () {
        var nav = document.getElementById('nav');
        var progress = document.getElementById('scrollProgress');
        var backToTop = document.getElementById('backToTop');
        var sections = Array.prototype.slice.call(document.querySelectorAll('section[id]'));
        var navAnchors = Array.prototype.slice.call(document.querySelectorAll('#navLinks a, #navLinksMobile a'));
        var navToggle = document.getElementById('navToggle');
        var navLinksMobile = document.getElementById('navLinksMobile');
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        /* ---------------------------------------------------------------
           Active nav link — set directly; driven by IntersectionObserver
           (no per-frame measurement). A pin holds the clicked link during a
           programmatic scroll.
        ---------------------------------------------------------------- */
        var activeId = '';
        var pinnedId = null;

        function setActive(id) {
          if (!id || id === activeId) return;
          activeId = id;
          for (var i = 0; i < navAnchors.length; i++) {
            navAnchors[i].classList.toggle('active', navAnchors[i].getAttribute('href') === '#' + id);
          }
        }

        if ('IntersectionObserver' in window && sections.length) {
          var navH0 = nav ? nav.offsetHeight : 0;
          var spy = new IntersectionObserver(
            function (entries) {
              if (pinnedId) return;
              for (var e = 0; e < entries.length; e++) {
                if (entries[e].isIntersecting) setActive(entries[e].target.id);
              }
            },
            { rootMargin: '-' + (navH0 + 10) + 'px 0px -70% 0px', threshold: 0 }
          );
          sections.forEach(function (s) { spy.observe(s); });
        }

        /* ---- Lightweight scroll handler: nav bg, progress, back-to-top ---- */
        var ticking = false;
        function onScroll() {
          ticking = false;
          var y = window.scrollY || document.documentElement.scrollTop;
          if (nav) nav.classList.toggle('scrolled', y > 40);
          if (backToTop) {
            var show = y > 400;
            backToTop.classList.toggle('opacity-100', show);
            backToTop.classList.toggle('opacity-0', !show);
            backToTop.classList.toggle('pointer-events-none', !show);
            backToTop.classList.toggle('translate-y-4', !show);
            backToTop.classList.toggle('translate-y-0', show);
          }
          if (progress) {
            var h = document.documentElement.scrollHeight - window.innerHeight;
            progress.style.transform = 'scaleX(' + (h > 0 ? y / h : 0) + ')';
          }
        }
        window.addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
        }, { passive: true });

        /* ---- Custom fixed-duration smooth scroll (distance-independent) ---- */
        var scrolling = false;
        function scrollToY(destY, cb) {
          var maxY = document.documentElement.scrollHeight - window.innerHeight;
          destY = Math.max(0, Math.min(destY, maxY));
          if (prefersReduced) { window.scrollTo(0, destY); if (cb) cb(); return; }
          var startY = window.scrollY;
          var dist = destY - startY;
          if (Math.abs(dist) < 2) { if (cb) cb(); return; }
          var dur = 600, t0 = null;
          scrolling = true;
          function ease(p) { return 1 - Math.pow(1 - p, 3); }
          function step(ts) {
            if (t0 === null) t0 = ts;
            var p = Math.min((ts - t0) / dur, 1);
            window.scrollTo(0, startY + dist * ease(p));
            if (p < 1) requestAnimationFrame(step);
            else { scrolling = false; if (cb) cb(); }
          }
          requestAnimationFrame(step);
        }

        document.querySelectorAll('[data-scroll]').forEach(function (link) {
          link.addEventListener('click', function (e) {
            var hash = this.getAttribute('href');
            if (!hash || hash.charAt(0) !== '#') return;
            var target = document.querySelector(hash);
            if (!target) return;
            e.preventDefault();
            if (navLinksMobile) navLinksMobile.classList.remove('open');
            if (navToggle) navToggle.classList.remove('open');

            pinnedId = target.id;
            setActive(target.id);

            var navH = nav ? nav.offsetHeight : 0;
            var destY = target.getBoundingClientRect().top + window.scrollY - navH - 8;
            scrollToY(destY, function () { pinnedId = null; });
          });
        });

        /* ---- Mobile nav toggle ---- */
        if (navToggle && navLinksMobile) {
          navToggle.addEventListener('click', function () {
            navLinksMobile.classList.toggle('open');
            navToggle.classList.toggle('open');
          });
        }

        /* ---- Reveal on scroll ---- */
        var reveals = document.querySelectorAll('.reveal, .stagger');
        document.querySelectorAll('.stagger').forEach(function (group) {
          var children = group.children;
          for (var k = 0; k < children.length; k++) {
            children[k].style.setProperty('--stagger-delay', k * 80 + 'ms');
          }
        });
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in');
                  maybeAnimate(entry.target);
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12 }
          );
          reveals.forEach(function (el) { io.observe(el); });
        } else {
          reveals.forEach(function (el) { el.classList.add('in'); maybeAnimate(el); });
        }

        function maybeAnimate(el) {
          el.querySelectorAll('.skill').forEach(function (skill) {
            var v = skill.getAttribute('data-value');
            var bar = skill.querySelector('.bar i');
            if (bar && v) bar.style.width = v + '%';
          });
          el.querySelectorAll('.num[data-count]').forEach(countUp);
        }

        function countUp(elm) {
          var target = parseInt(elm.getAttribute('data-count'), 10) || 0;
          var dur = 1200, start = null;
          function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            elm.textContent = Math.floor(eased * target) + (target >= 100 ? '+' : '');
            if (p < 1) requestAnimationFrame(step);
            else elm.textContent = target + (target >= 100 ? '+' : '');
          }
          requestAnimationFrame(step);
        }

        /* ---- Typing effect ---- */
        var typedEl = document.getElementById('typed');
        if (typedEl && !prefersReduced) {
          var phrases = ['SDE @ AWS', 'Problem Solver', 'Backend Developer', 'Builder'];
          var pi = 0, ci = 0, deleting = false;
          function type() {
            var word = phrases[pi];
            typedEl.textContent = deleting ? word.substring(0, ci--) : word.substring(0, ci++);
            var delay = deleting ? 45 : 95;
            if (!deleting && ci === word.length + 1) { deleting = true; delay = 1400; ci = word.length; }
            else if (deleting && ci === -1) { deleting = false; ci = 0; pi = (pi + 1) % phrases.length; delay = 350; }
            setTimeout(type, delay);
          }
          type();
        } else if (typedEl) {
          typedEl.textContent = 'SDE @ AWS';
        }

        /* ---- Portfolio filter ---- */
        var filters = document.querySelectorAll('.filter');
        var cards = document.querySelectorAll('.work-card');
        filters.forEach(function (btn) {
          btn.addEventListener('click', function () {
            filters.forEach(function (f) {
              f.classList.remove('active', 'bg-accent/20', 'border-accent', 'text-ink');
              f.classList.add('text-muted');
            });
            btn.classList.add('active', 'bg-accent/20', 'border-accent', 'text-ink');
            btn.classList.remove('text-muted');
            var cat = btn.getAttribute('data-filter');
            cards.forEach(function (card) {
              var cats = (card.getAttribute('data-cat') || '').split(' ');
              card.classList.toggle('hide', !(cat === 'all' || cats.indexOf(cat) !== -1));
            });
          });
        });

        /* ---- 3D tilt on cards (fine-pointer, motion-OK only) ---- */
        if (!prefersReduced && isFinePointer) {
          document.querySelectorAll('.tilt').forEach(function (card) {
            var raf = null;
            card.addEventListener('mousemove', function (e) {
              if (raf) return;
              raf = requestAnimationFrame(function () {
                raf = null;
                var r = card.getBoundingClientRect();
                var px = (e.clientX - r.left) / r.width - 0.5;
                var py = (e.clientY - r.top) / r.height - 0.5;
                card.style.transform =
                  'perspective(900px) rotateY(' + px * 7 + 'deg) rotateX(' + -py * 7 + 'deg) translateY(-6px)';
              });
            });
            card.addEventListener('mouseleave', function () { card.style.transform = ''; });
          });
        }

        onScroll();
      });
    })();
  </script>
</Base>
