---
const stats = [
  { count: 900, label: 'LeetCode solved' },
  { count: 2, label: 'IEEE publications' },
  { count: 2, label: 'Companies' },
];

const skills = [
  { name: 'Java', value: 90 },
  { name: 'Go', value: 85 },
  { name: 'AWS (CDK, Lambda, DynamoDB)', value: 85 },
  { name: 'Distributed Systems & Microservices', value: 80 },
  { name: 'Python', value: 75 },
  { name: 'C / C++', value: 75 },
  { name: 'JavaScript / TypeScript', value: 65 },
  { name: 'Hyperledger Fabric', value: 60 },
];

const chips = ['DynamoDB', 'MySQL', 'Cassandra', 'Hive', 'CloudWatch', 'CloudFormation / CDK', 'Step Functions', 'Gin', 'Flutter', 'Git / CI-CD', 'REST APIs', 'System Design', 'LaTeX'];
---

<section id="about" class="py-24 px-6 md:px-10">
  <div class="mx-auto max-w-content">
    <div class="reveal mb-12">
      <span class="text-accent2 font-semibold tracking-widest uppercase text-sm">01 — About</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mt-2">About Me</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="reveal rounded-2xl border border-line bg-surface p-8">
        <p class="text-muted leading-relaxed mb-4">
          I'm Rahul Bangar, a Software Development Engineer at <strong class="text-ink">Amazon (AWS OpenSearch)</strong>
          with 2+ years of experience designing, building, and operating large-scale distributed systems and
          microservices on AWS. I ship customer-facing features end-to-end in <strong class="text-ink">Java and Go</strong>,
          and build the monitoring, alarming, and infrastructure-as-code (AWS CDK/CloudFormation) that keeps them reliable.
        </p>
        <p class="text-muted leading-relaxed mb-8">
          I earned my B.Tech in Computer Science from <strong class="text-ink">NIT Tiruchirappalli</strong>, love
          problem solving (900+ LeetCode problems solved), and enjoy working across distributed systems, cloud
          infrastructure, REST APIs, and observability.
        </p>
        <div class="grid grid-cols-3 gap-4">
          {stats.map((s) => (
            <div class="text-center">
              <span class="num block font-display text-3xl font-bold gradient-text" data-count={s.count}>0</span>
              <small class="text-muted text-xs">{s.label}</small>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal rounded-2xl border border-line bg-surface p-8">
        <div class="flex flex-col gap-5">
          {skills.map((skill) => (
            <div class="skill" data-value={skill.value}>
              <div class="flex justify-between text-sm mb-1.5">
                <span class="text-ink font-medium">{skill.name}</span>
                <span class="text-muted">{skill.value}%</span>
              </div>
              <div class="bar h-2 rounded-full bg-surface2 overflow-hidden">
                <i class="block h-full rounded-full grad transition-[width] duration-1000 ease-out" style="width:0%"></i>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="reveal mt-10 rounded-2xl border border-line bg-surface p-8">
      <p class="text-sm font-semibold text-muted uppercase tracking-widest mb-4">Also works with</p>
      <div class="stagger flex flex-wrap gap-3">
        {chips.map((chip) => (
          <span class="px-4 py-1.5 rounded-full border border-line bg-surface2 text-sm text-ink/90 transition-colors hover:border-accent hover:text-ink">
            {chip}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
